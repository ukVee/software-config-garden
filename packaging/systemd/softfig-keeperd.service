[Unit]
Description=soft-fig per-device keeper daemon
Documentation=https://github.com/ukv/software-config_garden
# The daemon talks to a vault on disk; nothing graphical, so don't gate
# on the desktop session. Mirrors sliver-dock.service's headless shape.
After=default.target

[Service]
Type=simple
# %h expands to the user's home; the daemon is a per-user installation.
ExecStart=%h/.local/bin/softfig-keeperd --garden %h/soft-fig_garden
Restart=always
RestartSec=2

# Headless daemon — no stdout chatter into the journal beyond errors.
StandardOutput=journal
StandardError=journal

# DELIBERATELY no filesystem/privilege sandboxing here. This daemon's job
# is to project a FUSE mount into the user's login session, and the usual
# hardening knobs are fundamentally incompatible with that:
#   * NoNewPrivileges=true makes execve() ignore the setuid bit, so the
#     setuid-root `fusermount3` helper that fuser shells out to cannot
#     mount -> EPERM ("Operation not permitted", os error 1) on
#     `softfig daemon unlock`.
#   * ProtectSystem=, PrivateTmp= (and the other namespacing options) give
#     the unit its own mount namespace with non-shared propagation; a FUSE
#     mount created inside it stays trapped in that namespace and is
#     invisible to the user's interactive shell — `ls ~/soft-fig_garden`
#     would still show only the keeper.toml pointer after a "successful"
#     unlock.
# If hardening is ever reintroduced (e.g. in the AUR PKGBUILD), it must use
# only knobs that neither block setuid nor create a mount namespace, and
# any namespacing option additionally needs MountFlags=shared.
# See docs/onboard-laptop.md (Troubleshooting).

[Install]
WantedBy=default.target
