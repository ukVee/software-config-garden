# Maintainer: <owner name> <owner email>   # PROPOSED — pending the owner's H9 answer; see ../README.md

pkgname=soft-fig
pkgver=1.0.0_alpha.1
pkgrel=1
pkgdesc="Encrypted local-first knowledge base: FUSE garden view + growlight fleet"
arch=('x86_64')
url="https://github.com/ukVee/software-config-garden"
license=('AGPL-3.0-or-later')
depends=('fuse3' 'systemd')
makedepends=('cargo' 'protobuf' 'fuse3')
conflicts=('soft-fig-bin')

# `_tag` is the real git tag (`v`-prefixed, prerelease segment intact); `pkgver`
# is its AUR-safe form (pkgver may not contain `-`). The tag does not exist yet
# — the owner cuts it and fills in the real sha256 at publish time (see
# ../README.md). `sha256sums=('SKIP')` is deliberate until then.
_tag="v1.0.0-alpha.1"
source=("https://github.com/ukVee/software-config-garden/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/software-config-garden-"*
  # The installed set (five binaries) exactly as the default-features release
  # build produces it; growlight-gui stays out (opt-in `gui` feature).
  # --locked: build against the committed Cargo.lock (reproducible-builds
  # groundwork, meta/spec-release.md → "Reproducible builds").
  cargo build --workspace --release --locked
}

check() {
  cd "$srcdir/software-config-garden-"*
  # The same gate CI runs on push. Tests self-reduce the Argon2id cost to the
  # minimum (m=8 KiB, t=1, p=1) so the suite stays fast, exactly as the repo's
  # CLAUDE.md documents — no special profile flag is needed.
  cargo test --workspace --no-fail-fast
}

package() {
  cd "$srcdir/software-config-garden-"*

  # --- binaries (the installed set) -> /usr/bin ---
  for bin in softfig softfig-keeperd softfig-growlightd softfig-mcp softfig-tui; do
    install -Dm755 "target/release/${bin}" "$pkgdir/usr/bin/${bin}"
  done

  # --- systemd USER units -> /usr/lib/systemd/user ---
  # "Set paths, never patch defaults" (meta/spec-release.md → Channels). The
  # shipped units point ExecStart at the ~/.local/bin source install; this
  # package installs to /usr/bin, so substitute the *path only*. The garden
  # default (--garden %h/soft-fig_garden) and every other behavior default are
  # left exactly as shipped — no distro divergence.
  install -Dm644 packaging/systemd/softfig-keeperd.service \
    "$pkgdir/usr/lib/systemd/user/softfig-keeperd.service"
  install -Dm644 packaging/systemd/softfig-growlightd.service \
    "$pkgdir/usr/lib/systemd/user/softfig-growlightd.service"
  sed -i 's|%h/.local/bin/|/usr/bin/|g' \
    "$pkgdir/usr/lib/systemd/user/softfig-keeperd.service" \
    "$pkgdir/usr/lib/systemd/user/softfig-growlightd.service"

  # --- desktop entry (softfig-tui only; growlight-gui is not installed) ---
  install -Dm644 packaging/desktop/softfig-tui.desktop \
    "$pkgdir/usr/share/applications/softfig-tui.desktop"
}
